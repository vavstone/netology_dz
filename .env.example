# Скопируйте этот файл в .env и заполните своими ключами
#api ключ для openai
OPENAI_API_KEY=sk-...
#api ключ для openrouter
OPENROUTER_API_KEY=sk-...
#используемый провайдер (варианты: openai, openrouter, ollama)
LLM_PROVIDER=openai



#чат-ассистент для дз 2_5
#краткое имя сервиса
SUPPORT_SERVICE_NAME=...
#провайдер, используемый для чата (например, openai)
MAIN_PROVIDER=...
#ключ провайдера чата
MAIN_PROVIDER_API_KEY=sk-...
#базовый url провайдера чата (например, https://api.openai.com/v1)
MAIN_PROVIDER_BASE_URL=...
#модель чата (например, gpt-4.1-nano)
MAIN_PROVIDER_MODEL=...
#провайдер, используемый для классификации обращений (например, openai)
CLASSIFIER_PROVIDER=...
#ключ провайдера классификации
CLASSIFIER_PROVIDER_API_KEY=sk-...
#базовый url провайдера классификации (например, https://api.openai.com/v1)
CLASSIFIER_PROVIDER_BASE_URL=...
#модель классификации (например, gpt-4.1-nano)
CLASSIFIER_PROVIDER_MODEL=...
#резервный провайдер, используемый если один из основных провайдеров недоступен (например, ollama)
FALLBACK_PROVIDER=...
#ключ резервного провайдера (например, ollama)
FALLBACK_PROVIDER_API_KEY=...
#базовый url резервного провайдера (например, http://localhost:11434/v1)
FALLBACK_PROVIDER_BASE_URL=...
#модель резервного провайдера (например, qwen2.5:3b)
FALLBACK_PROVIDER_MODEL=...
#таймаут ожидания доступности провайдера
SUPPORT_TIMEOUT_SECONDS=30
#количество попыток
SUPPORT_RETRY_ATTEMPTS=3
#лимит истории сообщений
SUPPORT_HISTORY_LIMIT=10
#параметры БД кеширования сообщений (например, localhost, 6379, 3600)
REDIS_HOST=...
REDIS_PORT=...
REDIS_TTL=...