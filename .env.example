# Скопируйте этот файл в .env и заполните своими ключами

#ОБЩЕЕ
#api ключ для huggingface
HF_TOKEN=hf_...
#api ключ для openai
OPENAI_API_KEY=sk-...
#api ключ для openrouter
OPENROUTER_API_KEY=sk-...
#используемый провайдер (варианты: openai, openrouter, ollama)
LLM_PROVIDER=openai



#чат-ассистент для дз 2_5
# --- Основные настройки сервиса ---
SUPPORT_SERVICE_NAME=CORP_DOCUMENTATION

# --- Провайдер для основной генерации ответов ---
MAIN_PROVIDER=openrouter
MAIN_PROVIDER_API_KEY=sk-...
MAIN_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
MAIN_PROVIDER_MODEL=openrouter/free

# --- Провайдер для классификации (может совпадать с MAIN_PROVIDER) ---
CLASSIFIER_PROVIDER=openrouter
CLASSIFIER_PROVIDER_API_KEY=sk-...
CLASSIFIER_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
CLASSIFIER_PROVIDER_MODEL=openrouter/free

# --- Fallback-провайдер (локальная Ollama) ---
FALLBACK_PROVIDER=ollama
FALLBACK_PROVIDER_API_KEY=ollama
FALLBACK_PROVIDER_BASE_URL=http://localhost:11434/v1
FALLBACK_PROVIDER_MODEL=qwen2.5:3b

# --- Общие параметры ---
SUPPORT_TIMEOUT_SECONDS=30
SUPPORT_RETRY_ATTEMPTS=3
SUPPORT_HISTORY_LIMIT=10
SUPPORT_LOG_PATH=./assistant.log

# --- Redis для кеширования ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600